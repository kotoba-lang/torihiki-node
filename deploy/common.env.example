# Shared by every validator on every host.
#
# WITNESSES is consensus state, not configuration: leadership rotates through
# it, so all four must read the same names in the same ORDER or they lead
# different rounds and the chain stops with nothing in the logs to say why.
WITNESSES=w1,w2,w3,w4
CHAIN_ID=torihiki-1

# name@ws://host:port for every validator, including this one. Use real
# hostnames or private IPs; 127.0.0.1 is for a single-host trial.
PEERS=w1@ws://10.0.0.11:19401,w2@ws://10.0.0.12:19401,w3@ws://10.0.0.13:19401,w4@ws://10.0.0.14:19401

# The clock. 10 is a backstop here — proposals come from messages, not ticks.
TICK_MS=10

# The escrow watcher stays OFF until there is a chain to watch.
#
# THOR_CHAIN is the chain whose inbound vault this venue accepts — "ETH",
# "BTC", "AVAX". NOT an address: THORChain's asgard rotates every few days, so
# the vault is fetched from /thorchain/inbound_addresses every poll and every
# address ever seen is remembered. A pinned address would stop being the vault
# at the next churn and the venue would quietly stop crediting deposits.
#
# THOR_VAULT pins one anyway, for a test that must not depend on the network.
# THOR_CHAIN=ETH
# THOR_URL=https://thornode.ninerealms.com
# THOR_POLL_MS=6000
# THOR_VAULT=
