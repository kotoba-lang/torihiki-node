# Per validator. ONE FILE PER HOST, mode 0600, owned by the torihiki user.
#
# SEED is this validator's signing key, 32 bytes of hex. Without it the node
# DERIVES a key from the chain id and the name — which is reproducible, which
# is exactly why it is a devnet key and not a mainnet one. A chain whose keys
# can be derived by anybody who knows its name has no validators, only names.
SEED_W1=

HTTP_PORT=8801
DATA_DIR=/var/lib/torihiki/w1
