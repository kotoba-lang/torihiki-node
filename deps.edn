        io.github.kotoba-lang/engi
        {:git/url "https://github.com/kotoba-lang/engi.git"
         :git/sha "3f3cf8aaa64aac115a9c2d94e6eb04faae993ae6"}
        io.github.kotoba-lang/torihiki
        {:git/url "https://github.com/kotoba-lang/torihiki.git"
         :git/sha "1a7ff9fc3e5e9879806a012f692fe05ae2e2009f"}}}
