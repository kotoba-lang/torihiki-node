;; A protocol upgrade, end to end: the operators vote a version in
;; (TARGET_VERSION, default 2), and from its height an order the account
;; cannot back is refused — which holds from version 2 on.
;;
;;   NODES=http://127.0.0.1:8801,... CHAIN_ID=... \
;;   SEEDS=w1=<hex>,w2=<hex>,w3=<hex>  (operators' signing seeds; 3 of 4 is >2/3) \
;;   NOTICE=<the chain's PROTOCOL_NOTICE> \
;;     kbb --backend sci -cp "src:$CP" script/upgrade_e2e.cljk
;;
;; The chain must have been started with CHAIN_VALIDATORS=1 (governance is
;; chain state only with a validator set) and PROTOCOL_NOTICE=NOTICE. SLACK
;; (default 600) is how many blocks past the notice the activation is set.
(ns upgrade-e2e
  (:require ["node:crypto" :as nc]
            [kotoba.lang.text :as str]
            [promesa.core :as p]
            [torihiki.address :as addr]
            [torihiki.auth :as auth]))

(defn- env [k] (or (aget js/process.env k) (throw (js/Error. (str "set " k)))))
(def chain (env "CHAIN_ID"))
(def nodes (str/split (env "NODES") #","))
(def notice (js/parseInt (env "NOTICE") 10))
;; The version to vote in (default 2). Order margin holds from 2 on, so the
;; checks below hold for any later version too.
(def target (let [v (js/parseInt (or (aget js/process.env "TARGET_VERSION") "2") 10)]
              (when-not (>= v 2) (println "FAIL: TARGET_VERSION must be 2 or more") (js/process.exit 1))
              v))

(def ^:private pkcs8 (js/Buffer.from "302e020100300506032b657004220420" "hex"))
(defn- key-of [seed-hex]
  (let [sk (nc/createPrivateKey #js {:key (js/Buffer.concat #js [pkcs8 (js/Buffer.from seed-hex "hex")])
                                     :format "der" :type "pkcs8"})]
    {:sk sk :pub (.toString (.export (nc/createPublicKey sk) #js {:format "der" :type "spki"}) "base64")}))
(defn- fresh-key []
  (let [{:keys [privateKey publicKey]} (js->clj (nc/generateKeyPairSync "ed25519") :keywordize-keys true)]
    {:sk privateKey :pub (.toString (.export publicKey #js {:format "der" :type "spki"}) "base64")}))
(def operators (into (sorted-map) (for [p (str/split (env "SEEDS") #",") :let [[w s] (str/split p #"=" 2)]]
                                    [w (key-of s)])))

(defn- J [u] (-> (js/fetch u #js {:signal (js/AbortSignal.timeout 5000)}) (.then #(.json %))
                 (.then #(js->clj % :keywordize-keys true)) (.catch (fn [_] nil))))
(defn- wait [ms] (p/create (fn [r _] (js/setTimeout r ms))))
(defn- fail! [what] (println "FAIL:" what) (js/process.exit 1))

(defn- send! [k t]
  (let [a (addr/derive (:pub k))]
    (p/let [acct (J (str (first nodes) "/account?id=" a))
            n (:next-nonce acct 1)
            sig (.toString (nc/sign nil (js/Buffer.from (auth/signing-payload chain a n t) "utf8") (:sk k)) "base64")
            _ (js/fetch (str (first nodes) "/tx")
                        #js {:method "POST"
                             :body (js/JSON.stringify (clj->js {:tx t :account a :nonce n :pubkey (:pub k) :sig sig}))})]
      sig)))

(defn- outcome
  "The final /tx-status of `sig`, waiting up to a minute."
  [sig]
  (p/loop [i 0]
    (p/let [o (J (str (first nodes) "/tx-status?sig=" (js/encodeURIComponent sig)))]
      (if (or (:final o) (> i 120)) o (p/do (wait 500) (p/recur (inc i)))))))

(defn- order [side level qty] {:tx :order :market 1 :side side :level level :qty qty :flags 0})

(defn- version [] (p/let [d (J (str (first nodes) "/duties"))] (:protocol-version d)))

(p/let [v0 (version)
        _ (when-not (= 1 v0) (fail! (str "expected version 1, the chain says " v0)))
        before (fresh-key)
        _ (p/-> (send! before {:tx :deposit :amount 10000000}) outcome)
        big (p/-> (send! before (order 0 900 50000000)) outcome)
        _ (println "version 1: 50,000,000-lot bid with $100k ->" (:status big) (:reason big))
        _ (when-not (= "applied" (:status big)) (fail! "version 1 should be unchanged"))
        head (J (str (first nodes) "/head"))
        ;; Slack past the notice: the proposal's vote window closes at
        ;; `activation - notice`, and a vote that lands after it is a silent
        ;; no-op. A few hundred blocks covers the round trips at any speed.
        activation (+ (:engine-height head (:height head)) notice (js/parseInt (or (aget js/process.env "SLACK") "600") 10))
        [w1 & voters] (vals operators)
        p1 (p/-> (send! w1 {:tx :upgrade-propose :version target :activation activation}) outcome)
        d1 (J (str (first nodes) "/duties"))
        proposal (:protocol-last-proposal d1)
        _ (println (str "propose v" target " at") activation "->" (:status p1) (:reason p1) "— proposal" proposal)
        votes (p/all (for [k voters] (p/-> (send! k {:tx :upgrade-vote :proposal proposal}) outcome)))
        _ (println "votes ->" (mapv (juxt :status :reason) votes))
        d2 (J (str (first nodes) "/duties"))
        _ (when-not (= target (:version (:protocol-scheduled d2)))
            (fail! (str "the votes did not schedule version " target ": " (pr-str (:protocol-scheduled d2)))))
        _ (p/loop [i 0]
            (p/let [v (version)]
              (cond (= target v) (println "version" target "active")
                    (> i 600) (fail! (str "version " target " never activated"))
                    :else (p/do (wait 1000) (p/recur (inc i))))))
        after (fresh-key)
        _ (p/-> (send! after {:tx :deposit :amount 10000000}) outcome)
        refused (p/-> (send! after (order 0 900 50000000)) outcome)
        _ (println (str "version " target ": the same bid ->") (:status refused) (:reason refused))
        m (J (str (first nodes) "/market"))
        ;; Half of what 10M backs at the mark and the market's initial-margin
        ;; rate (scaled by 1e9), so a moving mark does not decide the result.
        lots (quot (quot (* 10000000 1000000000) (* (:mark m) (:initial-margin-rate m))) 2)
        fits (p/-> (send! after (order 0 (dec (:mark m)) lots)) outcome)
        _ (println (str "version " target ":") lots "lots just under the mark (half of what 10M backs) ->" (:status fits) (:reason fits))
        acct (J (str (first nodes) "/account?id=" (addr/derive (:pub after))))
        _ (println "free collateral with that bid resting:" (:free-collateral acct) "order margin:" (:order-margin acct))]
  (cond
    (not (and (= "rejected" (:status refused)) (= "insufficient-margin" (:reason refused))))
    (fail! "the oversized order was not refused for margin")
    (not= "applied" (:status fits)) (fail! "an affordable order was refused")
    (not (< (:free-collateral acct) 10000000)) (fail! "a resting order did not reduce free collateral")
    :else (println (str "PASS: version " target " voted in; orders are margined from its height"))))
