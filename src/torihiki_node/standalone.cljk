;; The validator as an ordinary process.
;;
;;   W=w1 PEERS=w1@ws://127.0.0.1:19401,w2@ws://127.0.0.1:19402,... \
;;   HTTP_PORT=8801 kbb --backend sci -cp "src:<deps>" -m torihiki-node.standalone
;;
;; ## Why this exists, in one measurement
;;
;; The same engine — `inga.replica` taking `torihiki.state` through its machine
;; seam — was run on two substrates and timed:
;;
;;   this shape (4 replicas, real sockets)   601 blocks / 20 s  =  33 ms
;;   Cloudflare Durable Objects (deployed)                        184-211 ms
;;
;; and the harness that produced 33 ms ticked every 120 ms, five times SLOWER
;; than the deployed clock. Progress is driven by messages, not by the clock:
;; counted on the deployment, `propose-on-msg 10-12` against `propose-on-tick
;; 0`. Every proposal there is already event-driven and it still takes 200 ms,
;; because a Durable Object serialises what arrives — a message queues behind
;; whatever the object is doing, and it is always doing something.
;;
;; So the gap to Hyperliquid's ~70 ms was never the engine, the transport, the
;; block interval or the commit rule; each of those was measured and cleared.
;; It is one property of the substrate, and this file is the substrate without
;; it. 33 ms is already under the target.
;;
;; ## Where it got to (2026-08-13)
;;
;; Four processes, one host, the real exchange with two markets:
;;
;;   all four replicas, identical block hash at height 500
;;   heights 1038-1047 and climbing
;;   block  min 1-2 ms   p50 7-8 ms   max 93-96 ms   (256 samples each)
;;
;; **7-8 ms at the median against 184-211 ms on Durable Objects**, and about
;; nine times under Hyperliquid's ~70 ms.
;;
;; The first run stopped at height 7 with every peer `:dropped` and
;; `failures 0` — nothing had failed to CONNECT, everything had failed to
;; parse. `:hash-fn` was `wire/wire-id` applied to the canonical block, a
;; function for witness names that does not return a hash; the ids it made
;; travelled inside votes and certificates, `inga.wire/decode` refused every
;; message carrying one, and `:dropped` is terminal. A transport that cannot
;; say which of those two it is costs a day, so `/head` now reports each
;; peer's state, failure count and next attempt.
;;
;; ## What it is NOT
;;
;; Not a replacement for the Worker yet. The deployed chain has persistence,
;; snapshots, quorum state transfer, subscriber sockets and an admin surface
;; that this does not; those are transport and operations concerns and they
;; port. What this establishes is the number, on the real exchange rather than
;; a stand-in machine, in a program that can run on any host.
(ns torihiki-node.standalone
  (:require ["ws" :as ws]
            ["node:crypto" :as nc]
            [torihiki-node.store :as store]
            [torihiki-node.claims :as claims]
            [torihiki-node.duties :as duties]
            [torihiki-node.epoch :as epoch]
            [inga.attest :as att]
            [torihiki-node.bridge-signer :as bsig]
            ["node:fs" :as fs]
            ["node:http" :as http]
            [kotoba.lang.text :as str]
            [kotoba.bytes.sha256 :as sha]
            [inga.consensus :as c]
            [inga.net.server :as srv]
            [inga.net.ws :as nws]
            [inga.replica :as r]
            [inga.wire :as wire]
            [torihiki.address :as addr]
            [torihiki.api :as api]
            [torihiki.auth :as auth]
            [torihiki.clearing :as cl]
            [torihiki.evm :as evm]
            [torihiki.evm.interp :as evmi]
            [torihiki.keccak :as kc]
            [torihiki.snapshot :as tsnap]
            [torihiki.thorchain :as tc]
            [torihiki.bridge :as br]
            [torihiki.governance :as gov]
            [torihiki.validators :as vals]
            [torihiki.state :as st]))

(defn- env [k d] (or (some-> js/process .-env (aget k)) d))

(def chain-id (env "CHAIN_ID" "torihiki-standalone-1"))

(def witnesses
  "The validator set, ordered. Leadership rotates through it, so the ORDER is
  consensus state and not a detail of configuration — every replica has to
  read the same list in the same order or they lead different rounds."
  (vec (str/split (env "WITNESSES" "w1,w2,w3,w4") #",")))

(def me (env "W" "w1"))

(def peer-url
  "`name -> ws://host:port`, parsed from PEERS=w1@ws://…,w2@ws://…

  An ADDRESS BOOK, not the validator set: with epochs (`torihiki-node.epoch`)
  the set is chain state, and a validator that joins later is reached at the
  address listed here."
  (into {} (for [p (str/split (env "PEERS" "") #",")
                 :when (str/includes? p "@")
                 :let [[n u] (str/split p #"@" 2)]]
             [n u])))

(def http-peer-url
  "`name -> http://host:port` for asking a peer about its state (`HTTP_PEERS`,
  same shape as PEERS). Without it, the local-cluster convention 8800 + n."
  (into {} (for [p (str/split (env "HTTP_PEERS" "") #",")
                 :when (str/includes? p "@")
                 :let [[n u] (str/split p #"@" 2)]]
             [n u])))

(defn- http-of [w]
  (or (get http-peer-url w)
      (str "http://127.0.0.1:" (+ 8800 (js/parseInt (subs w 1) 10)))))

;; The consensus segment this node runs (`torihiki-node.epoch`): segment 0 is
;; the configured chain; each epoch the chain installs starts the next.
(defonce seg (atom {:n 0 :base 0 :witnesses witnesses :pubkeys {}}))
;; Every segment so far, for verifying evidence from any of them.
(defonce segments (atom [{:n 0 :base 0}]))

(defn- current-witnesses [] (:witnesses @seg))

(def tick-ms
  "How often the clock runs. **10 by default, and it is a backstop here.**

  On the Worker this had a floor: a Durable Object alarm asked for 10 ms
  delivered a 42-57 ms median gap, worse than asking for 25. An interval in an
  ordinary process has no such floor, and it matters less anyway — proposals
  come from messages. What the clock does is time views out and re-send a vote
  nobody answered."
  (js/parseInt (env "TICK_MS" "10") 10))

;; ── keys ────────────────────────────────────────────────────────────────────

(def ^:private pkcs8-ed25519-prefix
  "The 16 bytes that turn a raw 32-byte Ed25519 seed into a PKCS8 key node
  accepts. Written out rather than pulled in: it is a constant of the format,
  and a dependency for sixteen bytes is a dependency to keep current."
  (js/Buffer.from "302e020100300506032b657004220420" "hex"))

(defn- key-from-seed [seed-hex]
  (let [seed (js/Buffer.from seed-hex "hex")
        der (js/Buffer.concat #js [pkcs8-ed25519-prefix seed])
        sk (nc/createPrivateKey #js {:key der :format "der" :type "pkcs8"})]
    {:private sk :public (nc/createPublicKey sk)}))

(defn- configured-seed [w] (env (str "SEED_" (str/upper w)) nil))
(defn- configured-pub [w] (env (str "PUB_" (str/upper w)) nil))

(defn- seed-for
  "A witness's seed. From `SEED_<w>` when it is set — that is how a real set is
  configured, one secret per host — and otherwise derived from the chain id
  and the name, which makes a local run reproducible without secrets lying
  around. A chain whose keys are derivable is a devnet and says so."
  [w]
  (or (configured-seed w) (sha/sha256-hex (str chain-id "/" w))))

(def keys-of (into {} (for [w witnesses] [w (key-from-seed (seed-for w))])))

(defn- b64 [buf] (.toString buf "base64"))

(defn- derived-pub [w]
  (b64 (.export (:public (get keys-of w)) #js {:format "der" :type "spki"})))

(defn- pub-of
  "A witness's public key: `PUB_<w>` when the genesis set names it, otherwise
  derived from the seed.

  **Without `PUB_<w>` this replica cannot run with per-host secrets at all.**
  Verification goes through here, and a derived public key is the public half
  of a seed only this process can compute — so a node holding its own real
  `SEED_W1` and deriving w2's key would reject every message w2 sends. The
  seed override existed and the matching public half did not, which made
  `SEED_<w>` a switch that broke the chain rather than one that secured it."
  [w]
  (or (get-in @seg [:pubkeys w])
      (configured-pub w)
      (when (get keys-of w) (derived-pub w))
      ;; A name outside the configured list (a validator that joined by
      ;; registering) on a devnet chain, whose keys are derived.
      (b64 (.export (:public (key-from-seed (seed-for w))) #js {:format "der" :type "spki"}))))

(def key-provenance
  "Where every key in this validator set came from, and what that means.

  ADR-2608040600 records the day this mattered: the deployed validators'
  private keys were computable from the public chain id, the derivation was
  confirmed against all four live public keys, **the BFT guarantee was zero,
  and the terminal displayed `4 replicas, agreeing`.**

  `seed-for`'s docstring already said a chain whose keys are derivable is a
  devnet and says so. Nothing said so. This is that sentence, made into a
  value the node reports.

  `:bft` is `:none` unless EVERY key is configured, and that is the whole
  point rather than pedantry: one derived peer key is a peer anybody can
  impersonate, and a quorum that includes an impersonated witness is not a
  quorum. A set that is three-quarters real is not three-quarters safe."
  (let [mine (if (configured-seed me) :configured :derived)
        peers (into {} (for [w witnesses]
                         [w (if (configured-pub w) :configured :derived)]))
        all? (and (= :configured mine) (every? #(= :configured %) (vals peers)))]
    {:mine mine
     :peers peers
     :bft (if all? :real :none)
     :note (if all?
             "every key is configured; forging a witness needs its secret"
             (str "DEVNET — at least one key is derivable from the public chain id, "
                  "so any observer can sign as that witness. This is not a "
                  "Byzantine-fault-tolerant chain, whatever the replica count says."))}))

(defn- sign-as [w]
  (fn [payload]
    (b64 (nc/sign nil (js/Buffer.from payload "utf8")
                  (:private (or (get keys-of w) (key-from-seed (seed-for w))))))))

(defn- verify-fn [w payload sig]
  (try
    (nc/verify nil (js/Buffer.from payload "utf8")
               (nc/createPublicKey #js {:key (js/Buffer.from (pub-of (wire/wire-id w)) "base64")
                                        :format "der" :type "spki"})
               (js/Buffer.from sig "base64"))
    (catch :default _ false)))

;; ── the exchange ────────────────────────────────────────────────────────────

(def markets
  [(assoc (cl/market {:id 1 :max-leverage 40 :tick 10 :lot 1})
          :taker-fee-rate 350000 :maker-fee-rate 100000 :symbol "BTC-PERP")
   (assoc (cl/market {:id 2 :max-leverage 25 :tick 10 :lot 1})
          :taker-fee-rate 500000 :maker-fee-rate 150000 :symbol "ETH-PERP")])

(defn genesis-exchange []
  ;; `:markets`, not `:market` plus `:list-market` for the rest.
  ;;
  ;; Listing a market on a running exchange gives it a book from the spec;
  ;; building the genesis that way here gave market 2 a book whose bitmap
  ;; slabs were absent and the first `state-root` walked into a null:
  ;; `Cannot read properties of null` out of `book/best`. Every book a
  ;; genesis declares gets `book-opts`, which is what `:markets` is for.
  (-> (st/new-exchange
       (cond-> {:markets markets
                :book-opts {:n-levels 65536 :cap 16384 :ev-cap 8192}}
         ;; `CHAIN_VALIDATORS=1`: the validator set, the oracle, upgrades and
         ;; (with `BRIDGE_CONTRACT`) the bridge are chain state (roadmap
         ;; D2-D5). A NEW chain: its genesis, and so its root, differs from a
         ;; chain without them, so give it its own `CHAIN_ID`.
         (env "CHAIN_VALIDATORS" nil)
         (assoc :validators {:genesis (duties/genesis-validators witnesses pub-of addr/derive)
                             :epoch-length (js/parseInt (env "EPOCH_LENGTH" "1000") 10)
                             :min-stake (js/parseInt (env "MIN_STAKE" "1") 10)}
                :protocol {})
         (and (env "CHAIN_VALIDATORS" nil) (env "BRIDGE_CONTRACT" nil))
         (assoc :bridge {:contract (str/lower (env "BRIDGE_CONTRACT" ""))
                         :evm-chain-id (js/parseInt (env "BRIDGE_EVM_CHAIN_ID" "0") 10)
                         :asset (env "BRIDGE_ASSET" "USDC")})))
      (as-> ex (reduce (fn [e m] (st/apply-tx e {:tx :oracle :market (:id m) :price 1000}))
                       ex markets))))

(defn- tx-verify [pubkey payload sig]
  (try
    (nc/verify nil (js/Buffer.from payload "utf8")
               (nc/createPublicKey #js {:key (js/Buffer.from pubkey "base64")
                                        :format "der" :type "spki"})
               (js/Buffer.from sig "base64"))
    (catch :default _ false)))

(defn- decode-tx [s]
  (let [m (js->clj (js/JSON.parse s) :keywordize-keys true)]
    ;; Normalised BEFORE the signing payload is computed, or the two sides
    ;; disagree about `:order` versus `"order"` and every signature fails for
    ;; a reason that looks like cryptography and is not.
    (update m :tx (fn [t] (cond-> t (string? (:tx t)) (update :tx keyword))))))

(defn- machine-for
  "The machine for segment `sg`. `init-fn` builds its first state (the genesis
  exchange for segment 0, the state at the boundary after that).

  Engine heights are the segment's base plus inga's, and a segment whose
  engine has moved to a later epoch applies nothing more: see
  `torihiki-node.epoch`."
  [sg init-fn segs]
  {:init-fn init-fn
   :apply-fn (fn [ex block]
               (if (or (epoch/frozen? ex (:n sg))
                       ;; A later segment's genesis IS the boundary block,
                       ;; already applied by the segment before. Applying it
                       ;; again re-ran the boundary and turned the epoch once
                       ;; more, every block. Segment 0 is left as it was.
                       (and (pos? (:n sg)) (zero? (:inga.block/height block))))
                 ex
               (st/apply-block ex {:height (epoch/engine-height sg (:inga.block/height block))
                                   :ts (:inga.block/ts block)
                                   :txs (mapv decode-tx (:inga.block/proposals block))}
                               {:chain-id chain-id :verify-fn tx-verify
                                :derive-account addr/derive
                                ;; From the chain's own epochs, not this node's
                                ;; list: every replica derives the same table.
                                :vote-verify-fn (epoch/vote-verifier chain-id (epoch/segments-of ex)
                                                                     tx-verify)})))
   :root-fn st/state-root})

(defonce segment-init (atom genesis-exchange))

(defn- replica-opts []
  (let [sg @seg]
  (cond->
  {:witness me
                    :witnesses (:witnesses sg)
                    :quorum (c/quorum-size (count (:witnesses sg)))
                    ;; hex of SHA-256 over the canonical block.
                    ;;
                    ;; This was `wire/wire-id` applied to the canonical block,
                    ;; which is a function for witness NAMES and does not
                    ;; return a hash — the ids it produced travelled inside
                    ;; votes and certificates, `inga.wire/decode` refused every
                    ;; message carrying one, and after enough refusals each
                    ;; peer was marked `:dropped`, which is terminal. All four
                    ;; replicas sat at height 7 with `failures 0` and every
                    ;; peer dropped: nothing had failed to CONNECT, everything
                    ;; had failed to parse.
                    ;; A CIDv1 dag-cbor, the same identity the Worker
                    ;; deployment uses. It was a bare SHA-256 hex over
                    ;; `canonical-block`, which was a correct hash and not an
                    ;; ADDRESS: a hex digest cannot be a tag-42 link, so every
                    ;; block this replica produced was unpublishable as a DAG
                    ;; and the two deployments disagreed about what a block is
                    ;; called. Aligning them costs a genesis restart here and
                    ;; nothing else, because no standalone chain is deployed;
                    ;; leaving them apart costs a migration later.
                    :hash-fn store/block-cid
                    :chain-id (epoch/segment-chain-id chain-id (:n sg))
                    :sign-fn (sign-as me)
                    :verify-fn verify-fn
                    :machine (machine-for sg @segment-init @segments)}
    (:genesis sg) (assoc :genesis (:genesis sg)))))

;; One definition of what this replica IS. `resume` needs exactly the options
;; `replica` took — the injected seams are functions and a snapshot cannot
;; carry them, so the caller puts them back. Two copies of this map would be
;; two definitions: a different hash-fn or machine on the resume path is a
;; replica that agrees on the order and disagrees on the result, which every
;; number about it would hide.
(defonce state (atom (r/replica (replica-opts))))

(defonce registry (atom {}))
(defonce out-node (atom nil))
(defonce stats (atom {:msgs-in 0 :msgs-out 0 :blocks []}))

(defn- now [] (.getTime (js/Date.)))

(defn- ship!
  "Send the outbox, and send each message to WHO IT IS FOR.

  This broadcast everything. `inga.replica` has always set `:to` and it was
  being ignored, which is invisible for votes and proposals — they go to
  everybody anyway — and fatal for sync: a replica that has fallen behind
  receives mostly the ANSWERS TO OTHER REPLICAS, each segment starting at a
  height it cannot reach, and refuses them one after another.

  Measured here, four replicas on one host: w3 sat at height 257 while the
  others ran at 409, with all three peers connected, **13,379 messages
  received** and nothing adopted. Being behind was what kept it behind. The
  Worker's own dispatch carries this note already; the standalone was written
  without it.

  Only the dialled sockets. Every replica dials every peer, so those reach
  everyone; also pushing down the inbound sessions sent each message twice."
  [outbox]
  (doseq [{:keys [msg to]} outbox]
    (swap! stats update :msgs-out inc)
    (when-let [n @out-node]
      (if (or (nil? to) (= :all to))
        ((:broadcast! n) msg)
        ((:send! n) to msg)))))

(defn- note-height! [h]
  ;; The block interval, from the inside, the same way the Worker reports it —
  ;; so the two substrates are compared on the same number and not on two
  ;; definitions of "a block".
  (swap! stats
         (fn [s]
           (if (= h (:last-height s))
             s
             (-> s
                 (assoc :last-height h :last-height-at (now))
                 (update :blocks
                         (fn [v] (let [v (or v [])]
                                   (if-let [t (:last-height-at s)]
                                     (vec (take-last 256 (conj v (- (now) t))))
                                     v)))))))))

(defonce ^:private voted-view-path (atom nil))
(defonce ^:private voted-view-on-disk (atom -1))

(defn- keep-vote!
  "Write the vote watermark, and answer whether it is safe to send.

  `inga.replica/voted-view` is the safety contract of one-vote-per-view: a
  replica that votes in view V, dies without recording it, comes back not
  knowing, and votes again in V for a different block has equivocated — by
  accident, against itself. So the record has to be on disk BEFORE the vote is
  on the wire.

  Synchronous, and that is the point: `appendFileSync` returning is the
  promise being kept. An async write would put the send and the record in a
  race, which is the whole hazard.

  Only when it moves — at most once a view, not once a message."
  []
  (let [v (r/voted-view @state)]
    (if (<= v @voted-view-on-disk)
      true
      (try
        (fs/writeFileSync @voted-view-path (str v))
        (reset! voted-view-on-disk v)
        true
        (catch :default _
          ;; The write failed, so the vote must not go. A vote nobody
          ;; recorded is a vote that can be cast twice.
          false)))))

(def ^:private member-only
  "Messages only a member of the current set may send or be heard sending."
  #{:vote :new-view :proposal})

(defn- member? [w] (boolean (some #{w} (:witnesses @seg))))

(defn- ship-kept!
  "Send `out` once the vote watermark is on disk. If the write fails, the
  votes stay home and everything else still goes: a new-view or a sync
  request is sent once per view, and dropping it with the vote would cost a
  whole timeout for no safety gained.

  An OBSERVER — a node outside the current set — sends none of the member
  messages. Its votes verify (it holds a real key) and inga folds a verified
  vote into a certificate; a certificate naming a non-member is then refused
  everywhere as `:not-admitted`, and the chain stalled on exactly that with
  w5 observing."
  [out]
  (let [out (if (member? me) out (remove #(member-only (get-in % [:msg :type])) out))]
    (if (keep-vote!)
      (ship! out)
      (ship! (remove #(= :vote (get-in % [:msg :type])) out)))))

(defonce halted (atom nil))

(defn- check-halt!
  "Stop following the chain when it has voted past this binary's protocol."
  []
  (when-not @halted
    (when-let [why (duties/halt-reason (:machine-state @state))]
      (reset! halted why)
      (js/console.error (str "torihiki " me ": HALTED — " why)))))

(defn- feed! [msg]
  (swap! stats update :msgs-in inc)
  (when-not (or @halted
                ;; The receiving half of the same rule: a vote, new-view or
                ;; proposal from outside the current set is not consensus.
                (and (member-only (:type msg))
                     (let [w (or (:witness msg) (get-in msg [:block :inga.block/proposer]))]
                       (and w (not (member? (wire/wire-id w)))))))
  (let [[s' out] (r/on-message @state msg (now))]
    (reset! state s')
    (note-height! (r/height s'))
    ;; Sent HERE, as the message is folded, not on the next tick. On the
    ;; Worker this was the difference between a block every 250 ms and a block
    ;; every 150: a reply that waits for a clock adds a clock to every hop.
    ;;
    ;; But only after the watermark is down.
    (ship-kept! out)
    (check-halt!))))

(defn- quantiles [v]
  (when (seq v)
    (let [s (vec (sort v))]
      {:min (first s) :p50 (nth s (quot (count s) 2)) :max (peek s) :n (count s)})))

;; ── HTTP ────────────────────────────────────────────────────────────────────

;; Forward, because the HTTP surface answers with things the log section
;; defines and the log section needs the replica the HTTP section serves.
;; Declaring is smaller than moving either one.
(declare newest-checkpoint block-publisher)

(defn- json-response [res code body]
  (.writeHead res code #js {"Content-Type" "application/json"
                            "Access-Control-Allow-Origin" "*"})
  (.end res (js/JSON.stringify (clj->js body))))

(defn- read-body [req]
  (js/Promise.
   (fn [resolve _]
     (let [chunks (atom "")]
       (.on req "data" (fn [c] (swap! chunks str c)))
       (.on req "end" (fn [] (resolve @chunks)))))))

;; ── JSON-RPC ────────────────────────────────────────────────────────────────

(def ^:private zero-address "0x0000000000000000000000000000000000000000")

(def ^:const evm-chain-id
  "The chain id an EVM caller sees. Distinct from `chain-id`, which is this
  chain's own name and is not a number — an EIP-155 signature covers a NUMBER,
  and reusing a string there is how a transaction signed for one chain becomes
  replayable on another."
  1337)

(defn- rpc-result [id v]
  {:jsonrpc "2.0" :id id :result v})

(defn- rpc-error [id code message]
  {:jsonrpc "2.0" :id id :error {:code code :message message}})

(defn- hex-quantity
  "A number as an EVM RPC quantity: `0x`-prefixed, no leading zeroes, and `0x0`
  for zero. Not the same encoding as a 32-byte word — a caller that pads a
  quantity gets rejected by strict clients, which is the kind of thing that
  works in curl and fails in ethers."
  [n]
  (str "0x" (.toString (js/Number n) 16)))

(defn- rpc-call
  "One JSON-RPC request against the exchange.

  The read surface only, and the methods a caller actually needs to reach the
  precompile: what chain this is, how far along it is, and `eth_call`. A
  method that is not here answers `method not found` rather than something
  shaped like a result — a node that invents answers for methods it does not
  implement is worse than one that admits the gap, because a library will
  believe it."
  [state* {:keys [id method params]}]
  (let [s @state*
        ex (:machine-state s)]
    (case method
      "eth_chainId" (rpc-result id (hex-quantity evm-chain-id))
      "net_version" (rpc-result id (str evm-chain-id))
      "eth_blockNumber" (rpc-result id (hex-quantity (r/height s)))

      "eth_getCode"
      (rpc-result id (str "0x" (get-in ex [:evm (some-> (first params) str/lower) :code] "")))

      "eth_call"
      (let [{:keys [to data]} (first params)
            to (some-> to str/lower)]
        (if-let [out (or (evm/call ex to data)
                         ;; Deployed bytecode, from CHAIN state — `:evm` is in
                         ;; the state root, so two replicas answering this
                         ;; question differently is a disagreement the root
                         ;; shows. A world kept in the node would have made it
                         ;; invisible.
                         (when-let [code (get-in ex [:evm to :code])]
                           (let [world (into {} (for [[a c] (:evm ex)]
                                                  [a {:code (kc/hex->bytes (:code c))}]))
                                 r (evmi/run ex world
                                             {:address to :caller zero-address :depth 0}
                                             (kc/hex->bytes code) data)]
                             (when (= :return (:status r)) (str "0x" (:data r))))))]
          (rpc-result id out)
          ;; `execution reverted` rather than a zero word, and for the reason
          ;; `torihiki.evm/call` returns nil: an answer of zeroes to a
          ;; question the exchange never understood is indistinguishable from
          ;; a real zero, and the caller has no way to find out which it got.
          (rpc-error id 3 "execution reverted")))

      ;; A balance in wei is not collateral in ticks and pretending otherwise
      ;; would put a number in front of every wallet that means something
      ;; else. The precompile is where collateral is read.
      "eth_getBalance" (rpc-result id "0x0")

      (rpc-error id -32601 (str "method not found: " method)))))

(declare bridge-signatures duty-status epoch-answer)

(defn- handle-http [^js req ^js res]
  (let [url (js/URL. (.-url req) "http://x")
        path (.-pathname url)
        q (fn [k] (.get (.-searchParams url) k))
        s @state
        ex (:machine-state s)]
    (case path
      "/head"
      (json-response res 200
                     {:witness me
                      ;; What this set may claim about itself
                      ;; (torihiki-node.claims). Running on ordinary hosts is
                      ;; D1's shape; it is not D1's gate.
                      :decentralization (claims/status :validator)
                      :height (r/height s)
                      ;; `:committed` is the list of committed blocks, not a height —
                      ;; reading it as one reported `null` on a chain that was
                      ;; committing every block.
                      :committed (count (:committed s))
                      ;; The root AT the committed tip, which is the only root
                      ;; two replicas can be compared on: at their own tips
                      ;; they are legitimately at different heights and
                      ;; different roots, and comparing those says nothing.
                      :committed-root
                      (when-let [b (last (:committed s))]
                        {:height (:inga.block/height b)
                         :root (:inga.block/state-root b)})
                      :view (:view (:pm s))
                      :state-root (st/state-root ex)
                      :pending (count (:pending s))
                      :block-store (store/status block-publisher)
                      ;; Whether this set is Byzantine-fault-tolerant at all.
                      ;; ADR-2608040600: four validators whose keys were
                      ;; computable from the public chain id, displayed as
                      ;; "4 replicas, agreeing".
                      :keys key-provenance
                      :msgs-in (:msgs-in @stats)
                      :msgs-out (:msgs-out @stats)
                      :inbound (count @registry)
                      ;; Which peers this replica can actually reach, from the
                      ;; driver's own state — not a count of sockets that were
                      ;; once opened. A replica talking to nobody and a replica
                      ;; whose peers are quiet look identical from the outside,
                      ;; and the first run could not tell them apart.
                      :live-peers (vec (map str (some-> @out-node :live (apply []))))
                      :peer-status (into {} (for [[k v] (:peers @(:state @out-node))]
                                              [(str k) {:state (str (:state v))
                                                        :failures (:failures v)
                                                        :next-in (when (:next-attempt v)
                                                                   (- (:next-attempt v) (now)))}]))
                      :block-ms (quantiles (:blocks @stats))
                      ;; Why a segment was refused, from `inga.replica` itself.
                      ;; A replica that is behind and not catching up looks
                      ;; exactly like one that is behind and being ignored;
                      ;; this is the difference.
                      :last-sync (:last-sync s)
                      :last-proposal (:last-proposal s)
                      :propose-refusal (:propose-refusal s)
                      :substrate "process"})

      "/.well-known/torihiki"
      (json-response res 200 (claims/status :validator))

      ;; A segment this node holds, for a peer that missed the handoff.
      "/epoch"
      (json-response res 200 (epoch-answer (js/parseInt (or (q "n") "0") 10)))

      ;; What this validator does besides voting, and whether it may.
      "/duties"
      (json-response res 200 (duty-status))

      "/bridge/signatures"
      (json-response res 200 (bridge-signatures (js/parseInt (or (q "epoch") "0") 10)))

      ;; The block hash at a given height, which is how two replicas are
      ;; compared. A block header carries no state root here — `canonical-block`
      ;; never had one — so "same root" is established the way consensus
      ;; establishes it: same chain, deterministic machine.
      ;; The newest checkpoint, for a peer that has to be repaired.
      ;;
      ;; A replica that adopted a block the quorum did not certify cannot get
      ;; back by syncing: every segment its peers offer starts at a height
      ;; whose parent is not the block it holds, and `inga.sync/adopt` only
      ;; appends. The way back is to take the state the quorum agrees on.
      "/snapshot"
      ;; From the LIVE replica, not from a checkpoint on disk.
      ;;
      ;; It answered from the newest disk checkpoint and said `no-checkpoint`
      ;; when there was none — and checkpoints are every 500 blocks, so a
      ;; replica that diverged early had nothing to be repaired from. Measured:
      ;; four replicas frozen together at height 149 with the repair path
      ;; installed and never firing, because every peer answered `ok false`.
      ;;
      ;; `r/snapshot` bounds itself (a tail of the chain, not the chain), so
      ;; answering from memory is neither large nor slow, and it is always
      ;; current — which is what a replica being repaired needs.
      (json-response res 200
                     {:ok true
                      ;; Which segment this is: a replica repairs only from
                      ;; peers in its own (`repair!`).
                      :segment (:n @seg)
                      :height (r/height s)
                      :root (st/state-root ex)
                      :edn (tsnap/write-string
                            (update (r/snapshot s) :machine-state tsnap/capture))})

      "/hash-at"
      (let [h (js/parseInt (or (q "h") "0") 10)
            b (first (filter #(= h (:inga.block/height %)) (:chain s)))]
        (json-response res 200 {:height h
                                :hash (when b ((:hash-fn s) b))
                                :have (count (:chain s))}))

      "/rpc"
      (-> (read-body req)
          (.then (fn [body]
                   (let [j (js->clj (js/JSON.parse body) :keywordize-keys true)]
                     (json-response res 200
                                    (if (vector? j)
                                      (mapv #(rpc-call state %) j)
                                      (rpc-call state j)))))))

      "/tx"
      (-> (read-body req)
          (.then (fn [body]
                   (swap! state r/submit body)
                   (json-response res 200 {:ok true}))))

      "/book"
      (json-response res 200 (api/book-snapshot ex (js/parseInt (or (q "m") "1") 10)))

      "/account"
      (json-response res 200 (api/account-state ex (js/parseInt (q "a") 10)))

      "/markets"
      (json-response res 200 {:markets (mapv #(api/market-info ex (:id %)) markets)})

      (json-response res 404 {:ok false :reason "no-such-route"}))))

;; ── start ───────────────────────────────────────────────────────────────────

;; ── the log ─────────────────────────────────────────────────────────────────

(def data-dir (env "DATA_DIR" (str ".torihiki/" me)))

(defn- seg-dir
  "Where the current segment's log, checkpoints and vote watermark live:
  DATA_DIR itself for segment 0, so an existing node's files are where they
  were; `epoch-<n>/` under it after that."
  []
  (let [n (:n @seg)]
    (if (zero? n) data-dir (str data-dir "/epoch-" n))))

(defn- log-path [] (str (seg-dir) "/chain.jsonl"))

(defonce persisted (atom 0))

(defonce block-publisher
  ;; Where a CID resolves, for anyone who is not this process.
  ;;
  ;; The log below is local and always written; this is the copy that makes a
  ;; block's identity mean something outside this machine. It is deliberately
  ;; NOT a local directory and NOT a Durable Object: superproject
  ;; ADR-2608039000's test is to delete the store and ask whether the data is
  ;; gone, and both of those fail it. Unconfigured is therefore a real state
  ;; that `/head` reports by name -- not a fallback that quietly writes the
  ;; blocks somewhere that looks like replication and is not.
  (let [cfg (store/config-from-env #(env % nil))]
    (if-let [ok (:ok cfg)]
      (store/publisher (store/block-store ok) nil)
      (store/publisher nil (:unconfigured cfg)))))

(defn- persist!
  "Append every block adopted since the last write.

  Cheap because the chain only grows: a block already in the log is a block
  this replica already decided to keep. The encoding is the Worker's — a
  `wire`-encoded proposal, one JSON object per line — so the two deployments
  write the same bytes for the same block and a log written by one can be read
  by the other.

  Synchronous. The volume is one small line per block and the ordering is the
  whole point: an append that lands out of order is a log that replays into a
  different chain. An async writer would need its own queue to promise what
  `appendFileSync` promises for free."
  []
  (let [chain (:chain @state)
        from @persisted]
    (when (< from (count chain))
      (let [new (subvec chain (min from (count chain)))]
        (fs/appendFileSync
         (log-path)
         (str (str/join "\n" (for [b new]
                                (js/JSON.stringify
                                 (clj->js (wire/encode {:type :proposal :block b})))))
              "\n"))
        (reset! persisted (count chain))
        ;; After the append, never inside it. The append is synchronous because
        ;; ordering is the whole point, and publication is a network call --
        ;; putting it on that path would mean either blocking the tick or
        ;; giving the log a queue it does not need.
        ;;
        ;; The Promise is not awaited and it never rejects: `publish!` counts
        ;; its own failures and keeps the last message, so a store that is
        ;; dropping every block shows up in `/head` as a rising `failed` rather
        ;; than as silence.
        (doseq [b new]
          (store/publish! block-publisher (store/block-cid b) (store/block-bytes b)))))))

(def ^:const checkpoint-every
  "How many blocks between checkpoints. **500.**

  The log alone is enough to come back, and it is the wrong thing to come back
  with once it is long: replay is O(chain), and a startup that grows without
  bound is a restart that eventually does not finish. On the Worker that is
  not a slow boot but a killed one — a Durable Object exceeding its CPU budget
  is RESET, so it boots, replays, exceeds it again, and never starts."
  500)

(def ^:const checkpoints-kept
  "How many to keep. **8**, and the number is not for redundancy.

  A replica repairing itself from peers needs a height it and they both hold,
  and a replica far enough behind to need repairing is exactly the one whose
  window has stopped overlapping. Two was measured to be too few on the
  deployment: the one replica that needed the state was the reason nobody
  could give it any."
  8)

(defonce last-ckpt (atom -1))

(defn- ckpt-path [h]
  (str (seg-dir) "/snap-" (.padStart (str h) 12 "0") ".edn"))

(defn- checkpoint!
  "The replica as data, so a restart does not have to fold the whole log.

  TWO snapshots compose here and each covers what the other cannot.
  `inga.replica/snapshot` bounds the consensus state — a tail of the chain,
  the certificates naming it, the pacemaker, and the `:voted-below` watermark
  that keeps a resumed replica from voting twice. Its `:machine-state` it
  carries whole, and this machine is an exchange holding `Book` records backed
  by typed arrays, which is not data and does not serialise.
  `torihiki.snapshot/capture` turns that into plain data whose
  `canonical-bytes` are byte-identical on restore — the only equality that
  matters here, because two states can be `=` and encode differently, and it
  is the encoding a validator signs."
  []
  (let [s @state
        h (r/height s)]
    (when (and (pos? h) (zero? (mod h checkpoint-every)) (not= h @last-ckpt))
      (try
        (fs/writeFileSync (ckpt-path h)
                          (tsnap/write-string
                           (update (r/snapshot s) :machine-state tsnap/capture)))
        (reset! last-ckpt h)
        (doseq [f (drop checkpoints-kept
                        (sort (fn [a b] (compare b a))
                              (filter #(str/starts-with? % "snap-")
                                      (array-seq (fs/readdirSync (seg-dir))))))]
          (fs/unlinkSync (str (seg-dir) "/" f)))
        (catch :default _
          ;; A checkpoint that fails is a slower restart, not a broken
          ;; replica. It must never take the tick with it.
          nil)))))

(defn- newest-checkpoint
  "The most recent checkpoint on disk, as `[height snapshot]`, or nil.

  Newest FIRST and the first one that reads wins. A checkpoint that will not
  parse is skipped rather than fatal — it is one slower start, and the older
  ones behind it are exactly what `checkpoints-kept` is for."
  []
  (when (fs/existsSync (seg-dir))
    (some (fn [f]
            (try
              (let [h (js/parseInt (subs f 5 (- (count f) 4)) 10)
                    snap (tsnap/read-string* (fs/readFileSync (str (seg-dir) "/" f) "utf8"))]
                [h (update snap :machine-state tsnap/restore)])
              (catch :default _ nil)))
          (sort (fn [a b] (compare b a))
                (filter #(str/starts-with? % "snap-")
                        (array-seq (fs/readdirSync (seg-dir))))))))

(defn- restore!
  "Replay the log into the replica.

  `r/replay` is what restores the chain, the certificates and the heights this
  replica already voted at — and, since the fix that closed the deploy-stall,
  the VIEW its own tip was proposed in. Without the log a restarted replica
  comes back at genesis and, if it leads, proposes a fresh block for a height
  it has already voted at. That is equivocation committed by accident against
  itself, and it is what four validators on Cloudflare did before they had
  one.

  A line that will not decode stops the replay rather than being skipped. The
  blocks after a hole do not attach to anything, so continuing would build a
  chain this replica never agreed to out of the pieces of one it did."
  []
  (fs/mkdirSync (seg-dir) #js {:recursive true})
  (reset! voted-view-path (str (seg-dir) "/voted-view"))
  ;; The watermark first. The log says what this replica ADOPTED; it does not
  ;; say what it voted for, so `replay` alone comes back believing it has never
  ;; voted — which is exactly the window the contract closes.
  (when (fs/existsSync @voted-view-path)
    (let [v (js/parseInt (fs/readFileSync @voted-view-path "utf8") 10)]
      (when (integer? v)
        (reset! voted-view-on-disk v)
        (swap! state r/with-voted-view v))))
  ;; The checkpoint first, then only the log ABOVE it.
  ;;
  ;; Replaying from zero is correct and gets slower every block; the point of
  ;; a checkpoint is that everything at or below it is already folded in.
  ;; `resume` also leaves the `:voted-below` watermark, which refuses at least
  ;; as much as the folded set did — refusing more costs a vote at a height
  ;; already decided, refusing less is equivocation.
  (let [[ck snap] (newest-checkpoint)]
    (when snap
      (swap! state (fn [_] (r/resume (replica-opts) snap)))
      (reset! last-ckpt ck)
      (println (str "  resumed from checkpoint " ck)))
    (when (fs/existsSync (log-path))
      (let [lines (remove str/blank? (str/split (fs/readFileSync (log-path) "utf8") #"\n"))
            blocks (reduce (fn [acc l]
                             (let [[msg] (wire/decode (js->clj (js/JSON.parse l)))]
                               (if-let [b (:block msg)]
                                 (conj acc b)
                                 (reduced acc))))
                           [] lines)
            above (filterv #(> (:inga.block/height %) (or ck 0)) blocks)]
        (when (seq above)
          (swap! state r/replay above))
        ;; `persisted` counts LINES already written, not blocks folded — the
        ;; log still holds everything below the checkpoint and appending from
        ;; the chain's count would write those heights a second time.
        (reset! persisted (count blocks))
        (println (str "  restored " (count above) " blocks above it, height "
                      (r/height @state)))))))

;; ── the escrow watcher ──────────────────────────────────────────────────────

(defonce watcher-nonce (atom 0))

(declare halted)

;; This node's own signed transactions the chain has not applied yet, by
;; nonce, so a lost one can be sent again (`duties/resubmit`).
(defonce own-pending (atom (sorted-map)))

(defn- attest! [tx]
  (when-not @halted
    (let [acct (addr/derive (pub-of me))
          nonce (swap! watcher-nonce
                       (fn [local] (duties/next-nonce (:machine-state @state) acct local)))
          tx (assoc tx :account acct)
          payload (auth/signing-payload chain-id acct nonce tx)
          env (js/JSON.stringify
               (clj->js {:tx tx :account acct :nonce nonce
                         :pubkey (pub-of me)
                         :sig ((sign-as me) payload)}))]
      (swap! own-pending assoc nonce {:envelope env :sent-at (r/height @state)})
      (swap! state r/submit env))))

(defonce last-nonce-check (atom 0))

(defn- resend-lost!
  "Send our own transactions again when the chain has stopped consuming our
  nonces for 20 blocks — one was lost, and every later one waits on it."
  []
  (let [t (now)]
    (when (and (seq @own-pending) (> t (+ @last-nonce-check 2000)))
      (reset! last-nonce-check t)
      (let [acct (addr/derive (pub-of me))
            [p' send] (duties/resubmit @own-pending
                                       (auth/expected-nonce (:machine-state @state) acct)
                                       (r/height @state) 20)]
        (reset! own-pending p')
        (doseq [e send] (swap! state r/submit e))))))

(defn- watch-thorchain!
  "Poll THORChain and attest what this validator sees.

  Nothing here decides anything: `torihiki.thorchain` says which observations
  are usable and `torihiki.state` decides when enough validators agree. This
  is the network in between, and it is separate from both for the reason the
  namespace docstring gives — the part that needs a network to run is the part
  that cannot be tested, so it holds as little as possible.

  ## Off, and it must stay off until `THOR_OBSERVE` is real
  
  This polled `/thorchain/queue/outbound` — the queue of payments THORChain is
  about to SEND. **Deposits do not appear there.** A vault funded while this
  ran would have been observed by nobody, attested by nobody and credited to
  nobody, and the money would have sat in the vault with the venue reporting
  nothing wrong. That is the worst failure this whole path exists to prevent,
  written into the thing preventing it.
  
  There is no thornode endpoint that lists recent inbounds to an address;
  observing them means an indexer (Midgard `/v2/actions?address=…`) or
  following specific transaction hashes. Which one, and the shape it answers
  in, has NOT been checked against the live network — this sandbox cannot
  reach thornode.
  
  So the source is `THOR_OBSERVE` and it has no default. Unset, the watcher
  fetches `/UNSET`, fails, and attests nothing — loudly useless rather than
  quietly wrong. **Do not fund a vault until this has been pointed at a real
  endpoint and a test deposit has been seen to arrive.**

  Off unless `THOR_CHAIN` is set. A watcher with no chain to watch would poll
  a public endpoint forever and attest nothing, which is a cost with no
  answer.

  ## The vault is FETCHED, and it moves

  It was an env var. THORChain rotates its asgard every few days, so a pinned
  address stops being the vault — and a watcher holding one would go on polling
  and simply stop crediting deposits, saying nothing, while the venue kept
  running. `/thorchain/inbound_addresses` is asked every poll for the chain we
  serve, and every address it has ever named is REMEMBERED: a deposit sent to
  the outgoing vault minutes before a rotation is still a real deposit.

  `THOR_VAULT` still pins one, for a test that must not depend on the network."
  []
  (when-let [chain (env "THOR_CHAIN" nil)]
    (let [base (env "THOR_URL" "https://thornode.ninerealms.com")
          every (js/parseInt (env "THOR_POLL_MS" "6000") 10)
          vaults (atom (if-let [v (env "THOR_VAULT" nil)] #{v} #{}))
          refresh! (fn []
                     (-> (js/fetch (str base "/thorchain/inbound_addresses"))
                         (.then #(.json %))
                         (.then (fn [j]
                                  (doseq [e (array-seq j)]
                                    (when (= chain (aget e "chain"))
                                      (when-let [a (aget e "address")]
                                        (swap! vaults conj a))))))
                         (.catch (fn [_] nil))))]
      (println (str "  escrow: watching " chain " via " base))
      (js/setInterval
       (fn []
         (refresh!)
         (-> (js/fetch (str base "/thorchain/lastblock"))
             (.then #(.json %))
             (.then (fn [j]
                      (let [tip (js/parseInt (or (some-> (aget j 0) (aget "thorchain"))
                                                 (aget j "thorchain") "0") 10)]
                        ;; **NOT the outbound queue.** See `THOR_OBSERVE`.
                        (-> (js/fetch (str base (env "THOR_OBSERVE" "/UNSET")))
                            (.then #(.json %))
                            (.then (fn [obs]
                                       (let [os (js->clj obs)]
                                       (doseq [tx (tc/deposits-in
                                                   (addr/derive (pub-of me))
                                                   @vaults tip os)]
                                         (attest! tx))
                                       (doseq [tx (tc/payouts-in
                                                   (addr/derive (pub-of me))
                                                   tip os)]
                                         (attest! tx)))))))))
             (.catch (fn [_]
                       ;; A poll that failed is a poll that failed. It is not
                       ;; evidence of anything and must not become an
                       ;; attestation, so there is nothing to do but try again.
                       nil))))
       every))))

;; ── the duties (roadmap D2-D4) ──────────────────────────────────────────────
;;
;; Each one only ever SUBMITS a signed transaction (`attest!`); the engine
;; decides what the set agrees on. The pure half is `torihiki-node.duties`.

(defonce evidence-sent (atom #{}))
(defonce last-evidence-check (atom 0))

(defn- submit-evidence!
  "Send every equivocation proof this replica holds and the chain has not acted
  on. inga already broadcasts proofs to its peers; this is what turns one into
  a slash, by anybody who saw it, without an operator choosing to."
  []
  (let [t (now)]
    (when (and (vals/enabled? (:machine-state @state))
               (> t (+ @last-evidence-check 1000)))
      (reset! last-evidence-check t)
      (doseq [tx (duties/evidence-to-submit
                  (:machine-state @state)
                  ;; inga counts heights within the segment; the engine,
                  ;; across all of them.
                  (map #(update % :inga.evidence/height (partial epoch/engine-height @seg))
                       (:equivocations @state))
                  @evidence-sent)]
        (swap! evidence-sent conj (vals/evidence-key tx))
        (attest! tx)))))

(defn- rpc! [url method params]
  (-> (js/fetch url #js {:method "POST" :headers #js {"content-type" "application/json"}
                         ;; A provider that hangs must cost one poll, not
                         ;; a promise per interval forever.
                         :signal (js/AbortSignal.timeout 10000)
                         :body (js/JSON.stringify
                                (clj->js {:jsonrpc "2.0" :id 1 :method method :params params}))})
      (.then #(.json %))
      (.then #(js->clj (.-result %) :keywordize-keys true))
      (.catch (fn [_] nil))))

(defn- hex->int [h] (when (string? h) (js/parseInt (str/replace h #"^0x" "") 16)))

(defonce bridge-state (atom {:from nil :sent #{} :tip nil :errors 0 :busy false :unsettled 0}))

(defn- cursor-path [] (str data-dir "/bridge-cursor"))

(defn- load-cursor
  "Where to read from: the cursor this node saved, else `BRIDGE_FROM_BLOCK`
  (the contract's deploy block). It used to start a thousand blocks behind
  the tip, so a node that came back after a long outage never read the
  deposits made while it was away."
  []
  (or (when (fs/existsSync (cursor-path))
        (let [n (js/parseInt (fs/readFileSync (cursor-path) "utf8") 10)]
          (when-not (js/isNaN n) n)))
      (some-> (env "BRIDGE_FROM_BLOCK" nil) (js/parseInt 10))))

(defn- save-cursor! [n]
  (try (fs/writeFileSync (cursor-path) (str n)) (catch :default _ nil)))

(defn- watch-bridge!
  "Read `TorihikiBridge` logs and attest what a quorum of RPC providers agrees
  on (`duties/agreed-logs`), from blocks deep enough not to be taken back.

  Off unless the chain is in bridge mode and `BRIDGE_RPCS` names providers.
  `BRIDGE_RPC_QUORUM` (default: all of them, at most 2) is how many must
  report a log identically before this validator attests it."
  []
  (let [rpcs (remove str/blank? (str/split (env "BRIDGE_RPCS" "") #","))
        k (js/parseInt (env "BRIDGE_RPC_QUORUM" (str (min 2 (max 1 (count rpcs))))) 10)
        every (js/parseInt (env "BRIDGE_POLL_MS" "5000") 10)
        window (js/parseInt (env "BRIDGE_WINDOW" "500") 10)
        cfg (:bridge (:machine-state @state))]
    (swap! bridge-state assoc :from (load-cursor))
    (when (and cfg (seq rpcs))
      (println (str "  bridge: watching " (:contract cfg) " via " (count rpcs) " RPCs, quorum " k))
      (js/setInterval
       (fn []
         (when-not (or @halted (:busy @bridge-state))
         (swap! bridge-state assoc :busy true)
         (-> (js/Promise.all (clj->js (map #(rpc! % "eth_blockNumber" []) rpcs)))
             (.then
              (fn [heights]
                (let [tip (duties/agreed-height (map hex->int (array-seq heights)) k)
                      safe (when tip (- tip br/min-confirmations))
                      from (:from @bridge-state)]
                  (swap! bridge-state assoc :tip tip)
                  (when (and safe from (<= from safe))
                    (let [to (min safe (+ from (dec window)))
                          q {:address (:contract cfg)
                             :fromBlock (str "0x" (.toString from 16))
                             :toBlock (str "0x" (.toString to 16))}]
                      (-> (js/Promise.all (clj->js (map #(rpc! % "eth_getLogs" [q]) rpcs)))
                          (.then
                           (fn [answers]
                             (let [answers (keep #(when % (vec %)) (array-seq answers))]
                               ;; Too few answers is not "no logs": the window
                               ;; is retried rather than skipped.
                               (when (>= (count answers) k)
                                 (doseq [tx (br/attestations (addr/derive (pub-of me)) cfg tip
                                                             (duties/agreed-logs answers k))
                                         :let [id [(:tx tx) (or (:txid tx) (:claim tx))]]
                                         :when (not ((:sent @bridge-state) id))]
                                   (swap! bridge-state update :sent conj id)
                                   (attest! tx))
                                 (if (duties/window-settled? answers k)
                                   (do (swap! bridge-state assoc :from (inc to))
                                       (save-cursor! (inc to)))
                                   (swap! bridge-state update :unsettled inc))))))))))))
             (.catch (fn [_] (swap! bridge-state update :errors inc)))
             (.finally (fn [] (swap! bridge-state assoc :busy false))))))
       every))))

(defn- bridge-signatures
  "This validator's signatures for every pending claim, for a relayer to
  collect (`script/bridge_relay.cljk`). Off without `BRIDGE_SIGNER_KEY`.

  `epoch` is the CONTRACT's validator epoch the signatures are for — pass it
  as `?epoch=` (read `epoch()` on the contract); a signature for another epoch
  simply fails to count there."
  [contract-epoch]
  (let [ex (:machine-state @state)
        cfg (:bridge ex)
        key (env "BRIDGE_SIGNER_KEY" nil)]
    (cond
      @halted {:error (str "halted: " @halted)}
      (nil? cfg) {:error "not in bridge mode"}
      (nil? key) {:error "no BRIDGE_SIGNER_KEY on this validator"}
      (not (and (integer? contract-epoch) (not (neg? contract-epoch)))) {:error "epoch must be a non-negative integer"}
      :else
      {:signer (bsig/address-of key)
       :epoch contract-epoch
       :claims (vec (for [{:keys [claim dest amount]} (take 100 (br/pending-withdrawals ex))
                          :let [d (br/withdrawal-digest cfg {:chain chain-id :claim claim :dest dest
                                                             :amount amount :epoch contract-epoch})]]
                      {:claim claim :dest dest :amount amount :digest d
                       :sig (bsig/sign-digest key d)}))})))

(defonce oracle-state (atom {:last nil :errors 0}))

(def ^:private venues
  "Public spot endpoints, by asset. A validator chooses which of these it
  trusts with `ORACLE_VENUES`; the point of the set being the oracle is that
  they do not all choose the same ones."
  {"coinbase" (fn [a] [(str "https://api.coinbase.com/v2/prices/" a "-USD/spot")
                       #(some-> % (aget "data") (aget "amount") js/parseFloat)])
   "kraken" (fn [a] [(str "https://api.kraken.com/0/public/Ticker?pair=" (if (= a "BTC") "XBT" a) "USD")
                     #(some-> % (aget "result") js/Object.values first (aget "c") first js/parseFloat)])
   "bitstamp" (fn [a] [(str "https://www.bitstamp.net/api/v2/ticker/" (str/lower a) "usd/")
                       #(some-> % (aget "last") js/parseFloat)])})

(defn- feed-oracle!
  "Publish this validator's price for each market in `ORACLE_MARKETS`
  (`1=BTC,2=ETH`), the median of `ORACLE_VENUES`, every `ORACLE_EVERY_MS`.
  Off unless set, and only on a chain whose set is the oracle."
  []
  (let [markets (for [p (remove str/blank? (str/split (env "ORACLE_MARKETS" "") #","))
                      :let [[m a] (str/split p #"=")]]
                  [(js/parseInt m 10) a])
        chosen (remove str/blank? (str/split (env "ORACLE_VENUES" "coinbase,kraken,bitstamp") #","))
        per-unit (js/parseFloat (env "ORACLE_USD_PER_UNIT" "1"))
        min-sources (js/parseInt (env "ORACLE_MIN_SOURCES" "3") 10)]
    (when (and (seq markets) (vals/enabled? (:machine-state @state)))
      (println (str "  oracle: " (count markets) " markets from " (str/join "," chosen)))
      (js/setInterval
       (fn []
         (when-not @halted
         (doseq [[m a] markets]
           (-> (js/Promise.all
                (clj->js (for [v chosen :let [src (get venues v)] :when src
                               :let [[url pick] (src a)]]
                           (-> (js/fetch url #js {:signal (js/AbortSignal.timeout 10000)})
                               (.then #(.json %)) (.then pick)
                               (.catch (fn [_] nil))))))
               (.then (fn [ps]
                        (when-let [p (some-> (duties/source-median (array-seq ps) min-sources)
                                             (duties/usd->units per-unit))]
                          (swap! oracle-state assoc :last {:market m :price p :at (now)})
                          (attest! {:tx :oracle-submit :market m :price p}))))
               (.catch (fn [_] (swap! oracle-state update :errors inc)))))))
       (js/parseInt (env "ORACLE_EVERY_MS" "5000") 10)))))

(defonce genesis-root (atom nil))

(defn- duty-status []
  (let [ex (:machine-state @state)]
    {:protocol-version (gov/active-version ex)
     :binary-knows duties/max-protocol
     :halted @halted
     :validator-set (when (vals/enabled? ex) (mapv :witness (vals/active-set ex)))
     :segment (select-keys @seg [:n :base :witnesses])
     :set-mismatch (duties/set-mismatch ex (current-witnesses) pub-of)
     :genesis-root @genesis-root
     :evidence-sent (count @evidence-sent)
     :own-pending (count @own-pending)
     :bridge (when (:bridge ex) (select-keys @bridge-state [:from :tip :errors :unsettled]))
     :oracle @oracle-state}))

;; ── epochs (torihiki-node.epoch) ───────────────────────────────────────────

(defn- epoch-file [dir] (str dir "/epoch.edn"))
(defn- machine-file [dir] (str dir "/machine.edn"))
(defn- boundary-file [dir] (str dir "/boundary.edn"))

(defn- install-segment!
  "Run segment `sg` from now on: a new replica on its set and genesis, its own
  log and watermark, starting from `machine-state` (the state at its base)."
  [sg machine-data]
  (reset! seg sg)
  (swap! segments (fn [ss] (vec (distinct (conj ss (select-keys sg [:n :base]))))))
  (reset! segment-init (fn [] (tsnap/restore machine-data)))
  (reset! state (r/replica (replica-opts)))
  (reset! persisted 0)
  (reset! last-ckpt -1)
  (fs/mkdirSync (seg-dir) #js {:recursive true})
  (reset! voted-view-path (str (seg-dir) "/voted-view"))
  (reset! voted-view-on-disk -1))

(defn- descriptor
  "What a segment is, as data a peer can compare: everything but the machine
  state, plus that state's root."
  [sg machine-data]
  {:n (:n sg) :base (:base sg) :witnesses (:witnesses sg) :pubkeys (:pubkeys sg)
   :genesis-parent (:inga.block/parent-hash (:genesis sg))
   :genesis-ts (:inga.block/ts (:genesis sg))
   :root (st/state-root (tsnap/restore machine-data))})

(declare catch-up!)

(defn- bootstrap-segment!
  "Propose a fresh segment's first block, if this node leads height 1. Every
  other member waits for exactly this proposal (inga's `start`), so every path
  into a segment has to make it — the handoff, a catch-up, and a restart. A
  leader that caught up without it left the new set at height 0 for good."
  []
  (when (and (zero? (r/height @state)) (= me (c/leader-for (:witnesses @seg) 1)))
    (let [[s' out] (r/start @state (now))]
      (reset! state s')
      (ship-kept! out))))

(defn- handoff!
  "Leave the frozen segment for the one the chain installed. Called once the
  engine has applied a boundary block — on every replica at the same block,
  since the engine decides it."
  []
  (let [s @state
        ex (:machine-state s)
        old @seg
        nxt (epoch/next-segment ex)
        b-inga (- (:base nxt) (:base old))
        b-block (some #(when (= b-inga (:inga.block/height %)) %) (:chain s))]
    (if-not b-block
      ;; B is not in this replica's chain (a resumed chain keeps only a short
      ;; tail). Inventing a parent would derive a genesis nobody else has and
      ;; strand this node; its peers have the handoff, so ask them.
      (catch-up!)
    (let [parent (store/block-cid b-block)
        nxt (assoc nxt :genesis (epoch/genesis-block nxt parent (:ts ex)))
        data (tsnap/capture ex)
        boundary {:block b-block :qc (get (:qcs s) parent)}
        carried (concat (:pending s) (epoch/abandoned-proposals (:chain s) b-inga))]
    (reset! last-evidence-check 0)
    (submit-evidence!)
    (install-segment! nxt data)
    (fs/writeFileSync (machine-file (seg-dir)) (tsnap/write-string data))
    (fs/writeFileSync (boundary-file (seg-dir)) (tsnap/write-string boundary))
    (fs/writeFileSync (epoch-file (seg-dir)) (tsnap/write-string (descriptor nxt data)))
    (doseq [t carried] (swap! state r/submit t))
    (println (str "torihiki " me ": epoch " (:n nxt) " from height " (:base nxt)
                  ", set " (str/join "," (:witnesses nxt))
                  (when-not (some #{me} (:witnesses nxt)) " (this node observes)")))
    (bootstrap-segment!)))))

(defn- local-pub
  "The public half of the key this node actually signs with."
  []
  (b64 (.export (:public (or (get keys-of me) (key-from-seed (seed-for me))))
                #js {:format "der" :type "spki"})))

(defn- check-own-key!
  "After an on-chain key rotation the set expects a key this node may not
  hold. Signing with the old one would only produce votes nobody accepts and
  transactions from an account the chain no longer associates with it; stop
  and say which key to install instead."
  []
  (when-let [k (get-in @seg [:pubkeys me])]
    (when (and (not= k (local-pub)) (not @halted))
      (reset! halted (str "the chain's consensus key for " me " is " k
                          " and this node signs with " (local-pub)
                          "; configure SEED_" (str/upper me) " for the rotated key"))
      (js/console.error (str "torihiki " me ": HALTED — " @halted)))))

(defn- load-latest-segment!
  "On start: resume the newest segment this node has on disk."
  []
  (when (fs/existsSync data-dir)
    (let [ns* (sort > (keep #(some->> (re-matches #"epoch-([0-9]+)" %) second (js/parseInt))
                            (array-seq (fs/readdirSync data-dir))))]
      ;; The newest complete one; the ones before it only matter as
      ;; history, which the engine's own epochs already carry.
      (when-let [n (first (filter #(let [dir (str data-dir "/epoch-" %)]
                                     (and (fs/existsSync (epoch-file dir)) (fs/existsSync (machine-file dir))))
                                  ns*))]
        (let [dir (str data-dir "/epoch-" n)
              d (tsnap/read-string* (fs/readFileSync (epoch-file dir) "utf8"))
              data (tsnap/read-string* (fs/readFileSync (machine-file dir) "utf8"))
              sg (-> (select-keys d [:n :base :witnesses :pubkeys])
                     (assoc :genesis (epoch/genesis-block d (:genesis-parent d) (:genesis-ts d))))]
          (install-segment! sg data))))))

(defonce next-catch-up (atom 0))

(defn- boundary-ok?
  "Is `b` ({:block :qc}) the boundary `d` names, certified by the current
  segment's set under its own chain id?"
  [d b]
  (let [sg @seg
        blk (:block b)
        qc (:qc b)]
    (boolean
     (and blk qc
          (= (:genesis-parent d) (store/block-cid blk))
          (= (- (:base d) (:base sg)) (:inga.block/height blk))
          (= (:genesis-parent d) (:inga.qc/block-hash qc))
          (nil? (att/verify-certificate qc (epoch/segment-chain-id chain-id (:n sg))
                                        (c/quorum-size (count (:witnesses sg)))
                                        verify-fn (set (:witnesses sg))))))))

(defn- catch-up!
  "A node that missed a boundary — down while the set handed off — takes the
  next segment from its peers, on f + 1 identical descriptors and a machine
  state whose root matches them."
  []
  (let [t (now)
        want (inc (:n @seg))]
    (when (>= t @next-catch-up)
      (reset! next-catch-up (+ t 10000))
      ;; Only members of the segment this node is leaving: f + 1 of THEM
      ;; includes an honest one. Counting the whole address book let f
      ;; members and one observer agree on a forgery.
      (let [peers (remove #{me} (current-witnesses))
            need (inc (quot (dec (count (current-witnesses))) 3))]
        (-> (js/Promise.all
             (clj->js (for [p peers]
                        (-> (js/fetch (str (http-of p) "/epoch?n=" want)
                                      #js {:signal (js/AbortSignal.timeout 5000)})
                            (.then #(.json %))
                            (.then #(js->clj % :keywordize-keys true))
                            (.catch (fn [_] nil))))))
            (.then (fn [rs]
                     (let [rs (->> (array-seq rs)
                                   (remove #(or (nil? %) (:error %)))
                                   ;; Through JSON every map key came back a
                                   ;; keyword; witness names are strings.
                                   (map #(update-in % [:descriptor :pubkeys]
                                                    (fn [m] (into {} (map (fn [[k v]] [(name k) v])) m))))
                                   (map #(update % :boundary
                                                 (fn [b] (when (string? b)
                                                           (try (tsnap/read-string* b) (catch :default _ nil)))))))
                           d (epoch/agreed-handoff (map :descriptor rs) need)
                           ;; And the boundary block itself, certified by the
                           ;; set being left: the new genesis's parent is a
                           ;; block that set actually agreed on.
                           src (some #(when (and (= d (:descriptor %)) (boundary-ok? d (:boundary %))) %) rs)]
                       (when (and d src (= want (:n d)) (> want (:n @seg)))
                         (fs/mkdirSync (str data-dir "/epoch-" want) #js {:recursive true})
                         (let [data (tsnap/read-string* (:machine src))]
                           (when (= (:root d) (st/state-root (tsnap/restore data)))
                             (let [sg (-> (select-keys d [:n :base :witnesses :pubkeys])
                                          (assoc :genesis (epoch/genesis-block d (:genesis-parent d)
                                                                               (:genesis-ts d))))]
                               (install-segment! sg data)
                               (fs/writeFileSync (machine-file (seg-dir)) (tsnap/write-string data))
                               (fs/writeFileSync (boundary-file (seg-dir)) (tsnap/write-string (:boundary src)))
                               (fs/writeFileSync (epoch-file (seg-dir)) (tsnap/write-string d))
                               (println (str "torihiki " me ": caught up to epoch " want
                                             " from " (count rs) " peers"))
                               (bootstrap-segment!))))))))
            (.catch (fn [_] nil)))))))

(defn- epoch-answer
  "Segment `n` as this node holds it, for a peer catching up."
  [n]
  (let [dir (str data-dir "/epoch-" n)]
    (if (and (pos? n) (fs/existsSync (epoch-file dir)))
      {:descriptor (tsnap/read-string* (fs/readFileSync (epoch-file dir) "utf8"))
       :machine (fs/readFileSync (machine-file dir) "utf8")
       ;; Sent as EDN text: a block and a certificate have namespaced keys and
       ;; sets that JSON would flatten.
       :boundary (when (fs/existsSync (boundary-file dir))
                   (fs/readFileSync (boundary-file dir) "utf8"))}
      {:error "no such segment here"})))

(defonce next-repair (atom 0))
(defonce stall (atom {:at -1 :since 0}))

(def ^:const stall-ms
  "How long a replica may sit at one height before it asks the quorum for its
  state. **15000.**

  Long enough that ordinary catching-up — which moves — never reaches it, and
  short enough that a replica which cannot rejoin does not sit out the day."
  15000)

(defn- repair!
  "Take the state the quorum agrees on, when our own chain cannot be extended.

  **Measured firing**, on a replica given a genuinely divergent history: one
  block in its log had its timestamp nudged, so its hash differed from the
  one the quorum holds and every block after it stopped attaching.

      restored 79 blocks above it, height 40
      repaired from the quorum at height 193
      → height 861 beside 859 / 861 / 863, and the same block hash at 450

  The first attempt to test this did not diverge at all: two clusters run
  separately produced the SAME chain, because a block here is a pure function
  of its parent — same genesis, same leader order, and `:ts` from the block
  interval rather than a wall clock. That determinism is why bringing another
  cluster history is not a test, and why breaking one block is.

  Triggered by NOT MOVING, not by a reason string.

  `:does-not-link` names the situation exactly and is the wrong trigger: a
  replica only sees it once it is close enough for a peer to offer the block
  right above its tip. One that is both divergent and far behind reports
  `:does-not-attach` — the offered range does not even meet its own — and that
  reason also appears constantly on a perfectly healthy chain when an answer
  arrives stale. Measured: a replica handed a foreign 121-block history sat at
  121 against peers at 4272, reporting `does-not-attach` and never once
  `does-not-link`.

  So the condition is the one that actually distinguishes: our height has not
  moved for `stall-ms` while a peer is ahead of us. Being behind is not enough
  — catching up looks like that too, and it is moving.

  Every peer must answer and every answer must agree, height and root. With
  four replicas the three peers ARE the quorum, so what they agree on needs no
  vote from the replica adopting it — and requiring unanimity among the peers
  is what stops one confused answer from moving a replica that was right.

  The LOG is rewritten too. Leaving our own history on disk would replay the
  chain we just abandoned on the next restart, which is the same divergence
  arriving a second time and looking like a fresh one."
  []
  (let [now (js/Date.now)
        s @state]
    (when (not= (r/height s) (:at @stall))
      (reset! stall {:at (r/height s) :since now}))
    (when (and (>= now @next-repair)
               (> (- now (:since @stall)) stall-ms))
      (reset! next-repair (+ now 5000))
      (-> (js/Promise.all
           (clj->js (for [p (remove #{me} (current-witnesses))]
                      (-> (js/fetch (str (http-of p) "/snapshot"))
                          (.then #(.json %))
                          (.then #(js->clj % :keywordize-keys true))
                          (.catch (fn [_] nil))))))
          (.then (fn [rs]
                   (let [rs (remove nil? (array-seq rs))]
                     ;; Every OTHER member: for an observer that is all of
                     ;; them, and counting `(dec n)` left it never repaired.
                     (when (and (= (count rs) (count (remove #{me} (current-witnesses))))
                                (every? :ok rs)
                                (every? #(= (:n @seg) (:segment %)) rs)
                                (apply = (map :height rs))
                                (apply = (map :root rs))
                                ;; Only forward. A quorum snapshot at or below
                                ;; where we already are is not a repair, and
                                ;; adopting it would throw away a chain that
                                ;; was fine for the sake of a slow peer.
                                (> (:height (first rs)) (r/height @state)))
                       (let [snap (-> (tsnap/read-string* (:edn (first rs)))
                                      (update :machine-state tsnap/restore))]
                         (reset! state (r/resume (replica-opts) snap))
                         (fs/writeFileSync (log-path) "")
                         (reset! persisted 0)
                         (reset! last-ckpt -1)
                         (println (str "  repaired from the quorum at height "
                                       (:height (first rs)))))))))
          (.catch (fn [_] nil))))))

(defn- config-errors
  "What is wrong with this replica's configuration, before anything listens.

  `PEERS` names this replica's own listening address, so a replica missing
  from it has no port. This used to fall through to port 0 with no peers and
  die later as `Maximum call stack size exceeded`, which reads as a bug in the
  node rather than a line missing from `common.env`."
  []
  (cond-> []
    ;; A node outside the genesis set may run as an observer, and join the set
    ;; later by registering; it still needs an address.
    (not (or (some #{me} witnesses) (contains? peer-url me)))
    (conj (str "W=" me " is neither in WITNESSES=" (str/join "," witnesses) " nor in PEERS"))
    (not (contains? peer-url me))
    (conj (str "PEERS has no entry for " me " (expected " me "@ws://host:port)"))
    (some #(not (contains? peer-url %)) witnesses)
    (conj (str "PEERS is missing "
               (str/join "," (remove #(contains? peer-url %) witnesses))))

    ;; Genesis parameters come from each host's environment and every one of
    ;; them is under the state root. Blocks carry no root, so hosts that
    ;; disagree here keep agreeing on blocks while their states split. Bad
    ;; values are refused; GENESIS_ROOT (below) catches values that are
    ;; merely different.
    (and (env "CHAIN_VALIDATORS" nil)
         (not (every? #(re-matches #"[1-9][0-9]*" (env % "1")) ["EPOCH_LENGTH" "MIN_STAKE"])))
    (conj "EPOCH_LENGTH and MIN_STAKE must be positive integers")

    (and (env "BRIDGE_CONTRACT" nil)
         (not (re-matches #"0x[0-9a-fA-F]{40}" (env "BRIDGE_CONTRACT" ""))))
    (conj "BRIDGE_CONTRACT must be a 20-byte 0x address")

    (and (env "BRIDGE_CONTRACT" nil)
         (not (re-matches #"[1-9][0-9]*" (env "BRIDGE_EVM_CHAIN_ID" "0"))))
    (conj "BRIDGE_EVM_CHAIN_ID must be the EVM chain id (a positive integer); it is part of every signature")

    (and (env "BRIDGE_RPCS" nil)
         (not (re-matches #"[0-9]+" (env "BRIDGE_FROM_BLOCK" ""))))
    (conj "BRIDGE_FROM_BLOCK (the contract's deploy block) is required to watch the bridge")))

(defn -main [& _]
  (when-let [errs (seq (config-errors))]
    (doseq [e errs] (js/console.error (str "torihiki: " e)))
    (js/process.exit 2))
  ;; Every host must start from the same state. Shown at /duties, and with
  ;; GENESIS_ROOT set, a host whose environment built anything else refuses
  ;; to start rather than fork silently.
  (reset! genesis-root (st/state-root (genesis-exchange)))
  (when-let [want (env "GENESIS_ROOT" nil)]
    (when (not= want @genesis-root)
      (js/console.error (str "torihiki: genesis root " @genesis-root " is not GENESIS_ROOT " want
                             " — this host's genesis parameters differ from the set's"))
      (js/process.exit 2)))
  (let [port (js/parseInt (second (str/split (get peer-url me "x:0") #":(?=[0-9]+$)")) 10)
        wss (ws/WebSocketServer. #js {:port port})
        n (atom 0)]
    (.on wss "connection"
         (fn [sock]
           (let [peer (str "in-" (swap! n inc))
                 handle (srv/attach! registry peer sock
                                     {:add-listener (fn [s ev f] (.on s ev f))
                                      :on-message (fn [_ m] (feed! m))})]
             (swap! registry update peer merge handle))))
    ;; BEFORE dialling. A replica that starts talking at genesis while its own
    ;; history is still on disk is a replica proposing against a chain it is
    ;; about to discover it already has.
    (load-latest-segment!)
    (restore!)
    (reset! out-node
            ;; Everybody in the address book, not just the current set: the
            ;; set changes at epoch boundaries and the sockets should not have
            ;; to.
            (nws/make-node {:peers (vec (remove #{me} (keys peer-url)))
                            :url-of peer-url
                            :on-message (fn [_ m] (feed! m))}))
    (.listen (http/createServer handle-http)
             (js/parseInt (env "HTTP_PORT" "8801") 10))
    ;; The height-1 leader bootstraps. Genesis has no certificate to extend, so
    ;; it is the one proposal made without one — every other replica waits for
    ;; it rather than proposing its own, which is what stops four replicas from
    ;; each starting a different chain.
    (bootstrap-segment!)
    (js/setInterval
     (fn []
       (when-let [nd @out-node] ((:tick! nd)))
       (when-not @halted
       (let [[s' out] (r/on-tick @state (now))]
         (reset! state s')
         (note-height! (r/height s'))
         ;; The tick votes too — `vote-on-tip` re-casts for an uncertified tip
         ;; in a fresh view — so the watermark goes down first here exactly as
         ;; it does in `feed!`. This shipped unconditionally, which left the
         ;; one-crash window `keep-vote!` exists to close open on every
         ;; timeout.
         (ship-kept! out)
         ;; Before anything is written: a state this binary must not have
         ;; produced is not one to persist.
         (check-halt!)
         (when-not @halted
           (persist!)
           (checkpoint!)
           (check-own-key!)
           (if (epoch/handoff-due? (:machine-state @state) @seg)
             (handoff!)
             (do (repair!)
                 ;; Asked every few seconds, not only when stalled: an
                 ;; observer that syncs slowly is never stalled, and it may be
                 ;; a member of the next set the others are waiting for.
                 (catch-up!)))
           (submit-evidence!)
           (resend-lost!)))))
     tick-ms)
    (watch-thorchain!)
    (watch-bridge!)
    (feed-oracle!)
    (println (str "torihiki " me " · peers " port " · http " (env "HTTP_PORT" "8801")
                  " · tick " tick-ms "ms"))))
