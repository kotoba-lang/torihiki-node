(ns torihiki-node.mempool-test
  "Transactions a node accepted survive a proposal that loses its height."
  (:require [cljs.test :refer [deftest is testing]]
            [torihiki-node.mempool :as m]))

(def ok (constantly true))
(defn- t [account nonce] {:tx {:tx :deposit :amount 1} :account account :nonce nonce :pubkey "k" :sig "s"})

(deftest only-what-could-still-apply-is-kept
  (is (= #{"a"} (set (keys (m/admit {} "a" (t 1 5) 0 5 ok)))) "the next nonce")
  (is (= #{"a"} (set (keys (m/admit {} "a" (t 1 7) 0 5 ok)))) "a little ahead: waits for the ones before it")
  (is (empty? (m/admit {} "a" (t 1 4) 0 5 ok)) "already spent")
  (is (empty? (m/admit {} "a" (t 1 (+ 5 64)) 0 5 ok)) "absurdly far ahead")
  (is (empty? (m/admit {} "a" (t 1 5) 0 5 (constantly false))) "a bad signature")
  (is (empty? (m/admit {} "a" (t nil 5) 0 nil ok)) "no account")
  (is (empty? (m/admit {} "a" (assoc (t 1 5) :nonce "5") 0 5 ok)) "a nonce that is not a number"))

(deftest the-verifier-runs-last
  (let [calls (atom 0)
        v #(do (swap! calls inc) true)]
    (m/admit {} "a" (t 1 4) 0 5 v)
    (m/admit {"a" {}} "a" (t 1 5) 0 5 v)
    (is (zero? @calls) "nothing cheap ruled out was verified")))

(deftest the-table-is-bounded
  (let [full (into {} (for [i (range 3)] [(str i) {:account 9 :nonce i :at 0 :sent-at 0}]))]
    (is (= full (m/admit full "x" (t 1 5) 0 5 ok (assoc m/defaults :cap 3))) "in all")
    (is (= full (m/admit full "x" (t 9 3) 0 0 ok (assoc m/defaults :per-account 3))) "per account")))

(deftest consumed-and-stale-are-forgotten
  (let [tr {"a" {:account 1 :nonce 5 :at 0 :sent-at 0}
            "b" {:account 1 :nonce 6 :at 0 :sent-at 0}
            "c" {:account 2 :nonce 1 :at 0 :sent-at 0}}
        expected {1 6 2 1}]
    (is (= #{"b" "c"} (set (keys (m/sweep tr 1000 expected)))) "nonce 5 was spent")
    (is (empty? (m/sweep tr 120001 expected)) "given up after the ttl")))

(deftest due-resends-in-nonce-order-and-not-too-often
  (let [tr {"n6" {:account 1 :nonce 6 :at 0 :sent-at 0}
            "n5" {:account 1 :nonce 5 :at 0 :sent-at 0}
            "q"  {:account 2 :nonce 1 :at 0 :sent-at 0}
            "fresh" {:account 3 :nonce 1 :at 0 :sent-at 2500}}
        [bodies tr'] (m/due tr 3000 ["q"])]
    (is (= ["n5" "n6"] bodies) "lowest nonce first; not what is still pending; not what was just sent")
    (is (= 3000 (get-in tr' ["n5" :sent-at])))
    (is (= 2500 (get-in tr' ["fresh" :sent-at])))
    (is (= [] (first (m/due tr' 3500 ["q"]))) "nothing again within the gap")
    (is (= ["fresh"] (first (m/due tr' 5500 ["q"]))))))

(deftest outcomes-are-per-signature
  (let [txs [{:sig "a"} {:sig "b"} {:sig "c"} {}]
        o (m/outcomes txs [{:index 1 :reason :bad-nonce} {:index 2 :reason :insufficient-margin}] 7)]
    (is (= {:status :applied :reason nil :height 7 :final true} (o "a")))
    (is (= {:status :rejected :reason :bad-nonce :height 7 :final false} (o "b")) "may still land")
    (is (= {:status :rejected :reason :insufficient-margin :height 7 :final true} (o "c")) "nonce consumed")
    (is (= 3 (count o)) "an unsigned entry has nothing to be looked up by")))

(deftest a-final-outcome-is-never-replaced
  (let [log (m/record-outcomes nil {"a" {:status :applied :final true :height 5}} 10)
        log (m/record-outcomes log {"a" {:status :rejected :reason :bad-nonce :final false :height 9}} 10)]
    (is (= :applied (get-in log [:by-sig "a" :status])) "the resubmitted copy's bad-nonce does not win"))
  (let [log (m/record-outcomes nil {"b" {:status :rejected :reason :bad-nonce :final false :height 5}} 10)
        log (m/record-outcomes log {"b" {:status :applied :final true :height 9}} 10)]
    (is (= :applied (get-in log [:by-sig "b" :status])) "a non-final one is")
    (is (= ["b"] (:order log)))))

(deftest the-outcome-log-is-bounded
  (let [log (reduce #(m/record-outcomes %1 {(str %2) {:final true}} 3) nil (range 5))]
    (is (= ["2" "3" "4"] (:order log)))
    (is (= #{"2" "3" "4"} (set (keys (:by-sig log)))))))
