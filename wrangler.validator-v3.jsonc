{
  // A SECOND validator deployment, with its own genesis validator set.
  //
  // It exists because the first one cannot be given new code: those Durable
  // Objects run what they booted with, never go idle enough to be evicted,
  // and survived both a deploy and a `renamed_classes` migration (measured
  // 2026-08-13). Everything written after that point — spot markets, the
  // reserve attestation, the two-chain commit, chosen leverage, sub-accounts
  // — is verified by tests alone, and a test is not a deployment.
  //
  // This chain is where that code is answered for. The first deployment is
  // untouched: different worker, different Durable Object namespace,
  // different keys.
  "name": "torihiki-validator-v3",
  "main": "dist-validator-v3/worker.js",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [{ "name": "VALIDATOR", "class_name": "ValidatorV2" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ValidatorV2"] }],
  "observability": { "enabled": true },

  // ── the escrow watcher ────────────────────────────────────────────────────
  //
  // Here rather than in `wrangler secret`, deliberately: none of it is secret,
  // and THOR_ASSETS is an allowlist that decides what counts as money. A
  // reviewer has to be able to see it, and a secret is exactly the kind of
  // configuration nobody reviews.
  //
  // Every value below was checked against Ethereum itself — see the ADR. The
  // one that cannot be is THOR_VAULT; read its note.
  "vars": {
    // Measured: this is the one public endpoint that answers a Worker. It is
    // also range-limited — a 64-block `eth_getLogs` span answers and 128 is
    // refused as "archive" — which is why `watchEth!` asks for 48.
    "ETH_RPC": "https://ethereum-rpc.publicnode.com",

    // THORChain's Router. Not pasted on trust: this address emits the exact
    // `Deposit(address,address,uint256,string)` topic derived by `keccak` in
    // this repo, and the memos in those logs are THORChain's own command
    // language ("=:b:bc1q…"). Queried live before it was written here.
    "THOR_ROUTER": "0xD37BbE5744D730a1d98d8DC97c42F0Ca46aD7146",

    // The asgard vaults deposits are accepted into.
    //
    // **This is the one value here that is not verified.** THORChain's own
    // `/thorchain/inbound_addresses` is behind a Cloudflare bot challenge and
    // returns "Just a moment" to every non-browser client — from a Worker AND
    // from an ordinary shell, so it is not a Workers limitation. These three
    // are the addresses observed RECEIVING Router deposits in recent blocks,
    // which is evidence and not authority: the Router lets a caller name any
    // recipient, so an address seen here is an address somebody sent to.
    //
    // The consequence is bounded and known: a deposit to a vault not on this
    // list is not credited, and nothing is lost — THORChain still holds it and
    // the log is still there once the address is added. The opposite mistake
    // is the dangerous one, which is why the list is an allowlist.
    //
    // **Before depositing, confirm the inbound address THORChain gives you is
    // one of these, and add it if not.** It churns every few days.
    "THOR_VAULT": "0xed23d1bf7ac2ce8b4c09a090e252ea6ee5145e6e,0x64fb273b328cde17b15d3fff2731b4096ff0a132,0x15a18266c5331ac3a7f6bc5cdf25bcc55561b4fa",

    // What this venue takes as collateral: address, the name it is booked
    // under, and the token's decimals.
    //
    // USDC, verified on-chain by `symbol()` and `decimals()` rather than
    // pasted. Its 6 decimals are also the venue's own, so it scales by
    // exactly 1 and cannot be mis-scaled at all — the reason to fund in this
    // and not in an 18-decimal token.
    //
    // Adding a line here is a decision about what counts as money. Anything
    // absent is dropped, which is what stops a token minted this morning from
    // being credited at face value.
    "THOR_ASSETS": "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48:ETH.USDC:6",

    // ── the price feed ────────────────────────────────────────────────────
    //
    // market : aggregator : the FEED's decimals : this venue's decimals
    //
    // Chainlink mainnet aggregators, read over the same eth_call path the
    // escrow watcher uses. Verified live before being written here:
    // BTC/USD 62539.00 and ETH/USD 1865.91766498, both with an updatedAt.
    //
    // The venue's 2 decimals put BTC at 6253900 and ETH at 186591 — well
    // inside the engine's i53 domain, and far from the constant 1000 every
    // market has carried since it was listed. That jump is safe only because
    // open interest is zero; on a venue with positions it would be a
    // repricing, not a configuration change.
    "PRICE_FEEDS": "1:0xF4030086522a5bEEa4988F8cA5B36dbC97BeE88c:8:2,2:0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419:8:2"
  }
}
